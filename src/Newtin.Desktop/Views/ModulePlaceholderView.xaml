<UserControl x:Class="Newtin.Desktop.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="28"
            MaxWidth="680" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock x:Name="PhaseNote" FontSize="14" TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrush}"/>
            <Button Content="Volver al inicio" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,22,0,0" Click="Back_Click"/>
        </StackPanel>
    </Border>
</UserControl>