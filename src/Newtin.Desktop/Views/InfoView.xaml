
<UserControl x:Class="Newtin.Desktop.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton"
                        Content="Actualizar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Refresh_Click"/>

                <Button x:Name="CancelButton"
                        Content="Cancelar"
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="Cancel_Click"/>
            </StackPanel>

            <TextBlock x:Name="LastUpdated"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <!-- Contenido con scrollbar personalizado -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource ModernScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Left">

                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Height="4"
                             Margin="0,0,0,12"
                             BorderThickness="0"
                             Visibility="Collapsed"
                             Foreground="{StaticResource MagentaBrush}"
                             Background="{StaticResource LineBrush}"/>

                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Foreground="{StaticResource ErrorBrush}"/>

                <StackPanel x:Name="SectionsPanel"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
