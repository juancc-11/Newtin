<UserControl x:Class="Newtin.Desktop.Views.SharedAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Newtin.Desktop.Controls">
    
<ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto">

    <ScrollViewer.Resources>
        <Style TargetType="{x:Type ScrollBar}"
               BasedOn="{StaticResource ModernScrollBarStyle}"/>
    </ScrollViewer.Resources>

        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Conéctate a un equipo remoto y administra los archivos de las carpetas autorizadas."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <controls:ShareConnectionForm x:Name="Form"/>

                    <TextBlock x:Name="FormError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{StaticResource ErrorBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ConnectButton" Width="42" Height="42" Padding="0"
                                ToolTip="Conectar al equipo remoto"
                                AutomationProperties.Name="Conectar al equipo remoto"
                                Style="{StaticResource PrimaryButtonStyle}" Click="Connect_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="20"/>
                        </Button>
                        <Button x:Name="CancelButton" Width="42" Height="42" Padding="0" Margin="10,0,0,0"
                                ToolTip="Cancelar operación" AutomationProperties.Name="Cancelar operación"
                                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                                Click="Cancel_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="18"/>
                        </Button>
                    </StackPanel>

                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                                 BorderThickness="0" Visibility="Collapsed"
                                 Foreground="{StaticResource MagentaBrush}"
                                 Background="{StaticResource LineBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Estado de conexión" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ConnectionStatus" Text="Desconectado"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="BrowserPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="16"
                    Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Explorador de carpetas compartidas" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <DockPanel Margin="0,12,0,10">
                        <TextBox x:Name="CurrentPathBox" Style="{StaticResource InputStyle}" IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="ParentButton" Width="40" Height="40" Padding="0"
                                ToolTip="Volver a la carpeta anterior"
                                AutomationProperties.Name="Volver a la carpeta anterior"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Parent_Click" IsEnabled="False">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="18"/>
                        </Button>
                        <Button Width="40" Height="40" Padding="0" Margin="8,0,8,0"
                                ToolTip="Actualizar contenido" AutomationProperties.Name="Actualizar contenido"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="18"/>
                        </Button>
                        <Button Width="40" Height="40" Padding="0" ToolTip="Añadir archivos para transferir"
                                AutomationProperties.Name="Añadir archivos para transferir"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Upload_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="18"/>
                        </Button>
                        <Button x:Name="DownloadButton" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                ToolTip="Descargar archivo seleccionado"
                                AutomationProperties.Name="Descargar archivo seleccionado"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Download_Click"
                                IsEnabled="False">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="18"/>
                        </Button>
                        <Button x:Name="DeleteButton" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                ToolTip="Eliminar elemento seleccionado"
                                AutomationProperties.Name="Eliminar elemento seleccionado"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Delete_Click"
                                IsEnabled="False">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="18"/>
                        </Button>
                        <Button Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                ToolTip="Verificar permisos de la carpeta"
                                AutomationProperties.Name="Verificar permisos de la carpeta"
                                Style="{StaticResource PrimaryButtonStyle}" Click="Permissions_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="18"/>
                        </Button>
                    </WrapPanel>
                    <ListView x:Name="RemoteItems" MinHeight="180" MaxHeight="420"
                              MouseDoubleClick="RemoteItems_MouseDoubleClick"
                              SelectionChanged="RemoteItems_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Type}" Width="110"/>
                                <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="480"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nueva carpeta" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NewFolderNameBox" Grid.Column="1" Style="{StaticResource InputStyle}"
                                 MinWidth="140" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Nombre de la nueva carpeta"/>
                        <Button Grid.Column="2" Width="40" Height="40" Padding="0" Margin="10,0,0,0"
                                ToolTip="Crear carpeta" AutomationProperties.Name="Crear carpeta"
                                Style="{StaticResource SecondaryButtonStyle}" Click="CreateFolder_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" FontSize="18"/>
                        </Button>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Renombrar elemento" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="RenameNameBox" Grid.Column="1" Style="{StaticResource InputStyle}"
                                 MinWidth="140" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Nuevo nombre del archivo o carpeta"/>
                        <Button x:Name="RenameButton" Grid.Column="2" Width="40" Height="40"
                                Padding="0" Margin="10,0,0,0" ToolTip="Renombrar elemento"
                                AutomationProperties.Name="Renombrar elemento"
                                Style="{StaticResource SecondaryButtonStyle}" Click="Rename_Click"
                                IsEnabled="False">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="18"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="BrowserError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource ErrorBrush}"/>
                </StackPanel>
            </Border>

            <Border x:Name="TransfersPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="16"
                    Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ClearTransfersButton" Width="40" Height="40" Padding="0"
                                    ToolTip="Quitar las filas seleccionadas del historial"
                                    AutomationProperties.Name="Limpiar transferencias seleccionadas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ClearTransfers_Click" IsEnabled="False" Margin="0,0,8,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="18"/>
                            </Button>
                            <Button x:Name="StartTransfersButton" Width="40" Height="40" Padding="0"
                                    ToolTip="Iniciar la transferencia de archivos marcados"
                                    AutomationProperties.Name="Iniciar transferencia"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="StartTransfers_Click" IsEnabled="False">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="18"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Cola de transferencias" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="TransfersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="False" HeadersVisibility="Column"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="TransfersGrid_SelectionChanged"
                              GridLinesVisibility="None" RowHeaderWidth="0" MinHeight="110" MaxHeight="360"
                              ColumnHeaderHeight="40" RowHeight="48"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="White" Foreground="Black" RowBackground="White"
                              AlternatingRowBackground="#FFF3F3F3" BorderBrush="#FFB8B8B8"
                              BorderThickness="1"
                              ItemsSource="{Binding Transfers}">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="#FFF0EDF4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderBrush" Value="#FFDBD7E0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFDCEBFA"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="#FFF0EDF4"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF7F5FA"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFDCEBFA"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="TransferValueTextStyle" TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                            <Style x:Key="TransferStatusTextStyle" TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource TransferValueTextStyle}">
                                <Setter Property="Foreground" Value="#FF514B57"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="Completada">
                                        <Setter Property="Foreground" Value="#FF176B43"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="En curso">
                                        <Setter Property="Foreground" Value="#FF5420A8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="Error">
                                        <Setter Property="Foreground" Value="#FFB42332"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="Error al limpiar">
                                        <Setter Property="Foreground" Value="#FFB42332"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusText}" Value="Cancelada">
                                        <Setter Property="Foreground" Value="#FF855700"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Enviar" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Checked="TransferSelection_Changed"
                                                  Unchecked="TransferSelection_Changed"
                                                  ToolTip="Marca este archivo para incluirlo al iniciar la transferencia."
                                                  AutomationProperties.Name="Incluir archivo en la transferencia"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Nombre del archivo" Width="1.35*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource TransferValueTextStyle}"
                                                   FontWeight="SemiBold" ToolTip="{Binding FileName}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Operación" Binding="{Binding Direction}" IsReadOnly="True"
                                                Width="0.8*" ElementStyle="{StaticResource TransferValueTextStyle}"/>
                            <DataGridTemplateColumn Header="Carpeta de destino" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DestinationPath}" Style="{StaticResource TransferValueTextStyle}"
                                                   ToolTip="{Binding DestinationPath}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Avance de transferencia" Width="2.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="2,4">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource TransferValueTextStyle}"
                                                           FontSize="11" ToolTip="{Binding ProgressText}"/>
                                            </Grid>
                                            <ProgressBar Height="7" Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsFinalizing, Mode=OneWay}"
                                                         Foreground="{StaticResource MagentaBrush}"
                                                         Background="#FFE2DEE7"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Velocidad" Binding="{Binding SpeedText}" IsReadOnly="True"
                                                Width="0.75*" ElementStyle="{StaticResource TransferValueTextStyle}"/>
                            <DataGridTemplateColumn Header="Resultado" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TransferStatusTextStyle}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   ToolTip="{Binding StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Acción" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="30" Height="26" Padding="0"
                                                MinWidth="0" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip="Cancelar transferencia"
                                                AutomationProperties.Name="Cancelar transferencia"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding IsCancelable}"
                                                Click="CancelTransfer_Click">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ResultsPanel"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
