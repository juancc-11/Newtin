<Window x:Class="Newtin.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="Newtin" Width="1200" Height="760" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI" Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid x:Name="MainLayout">
            
        <Grid.ColumnDefinitions>
        <!-- Barra lateral ampliada -->
            <ColumnDefinition Width="310"/>

        <!-- Área de contenido: ocupa el espacio restante -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


            <!-- Barra lateral -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F6F3FB" CornerRadius="12" Padding="10" Margin="0,0,0,16">
                        <Image Source="Resources/Images/logo.png" Height="140" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Logo de Newtin"/>
                    </Border>

                    
                    <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly">

                    <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                        BasedOn="{StaticResource ModernScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>


                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <RadioButton x:Name="AboutNav" Content="Acerca de" Tag="about"
                                     GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="SettingsNav" Content="Configuración" Tag="settings"
                                     GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                     Checked="Nav_Checked"/>
                        <Button Content="Salir" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,10,0,0" Click="Exit_Click"/>
                        <TextBlock x:Name="VersionText" Margin="0,12,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido -->
            <Grid Grid.Column="1" Margin="28,24,28,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PageSubtitle" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ServerDot" Width="10" Height="10"
                                         Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ServerStatusText" Text="Servidor detenido" Margin="8,0,0,0"
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ServerToggleButton" Content="Iniciar servidor" Margin="10,0,0,0" Padding="14,6"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ServerToggle_Click"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="ContentHost" Grid.Row="1" IsTabStop="False"/>

                <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,8,0,0"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="StatusMessage" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Pantalla de carga -->
        <Grid x:Name="LoadingOverlay" Background="{StaticResource BackgroundBrush}" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image gif:ImageBehavior.AnimatedSource="Resources/Animations/loading_animation.gif"
                       Width="200" Height="200"/>
                <TextBlock Text="Preparando Newtin..." FontSize="15" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
